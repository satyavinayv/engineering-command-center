# Copy this file to .env and fill in real values. Never commit .env.

# --- App ---
APP_ENV=local
API_KEY=changeme-choose-a-long-random-string

# --- Database ---
# SQLite by default (zero setup). Swap to a Postgres URL later, e.g.
# postgresql+psycopg2://user:pass@localhost:5432/eng_command_center
DATABASE_URL=sqlite:///./eng_command_center.db

# --- AI (optional, Phase 7) ---
AI_ENABLED=false
AI_PROVIDER=mock
OPENAI_API_KEY=

# --- Gmail (Phase 5) ---
GMAIL_USERNAME=
GMAIL_APP_PASSWORD=

# --- Jira (Phase 2) ---
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_JQL=assignee = currentUser() OR reporter = currentUser()

# --- GitLab (Phase 2) ---
GITLAB_BASE_URL=
GITLAB_PERSONAL_ACCESS_TOKEN=
GITLAB_PROJECT_IDS=

# --- OpenSearch (Phase 3) ---
OPENSEARCH_HOST=
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=

# --- Calendar (Phase 4) ---
CALENDAR_PROVIDER=
