# Copy this file to .env and fill in real values. Never commit .env.

# --- App ---
APP_ENV=local
API_KEY=changeme-choose-a-long-random-string

# --- Database ---
# SQLite by default (zero setup). Swap to a Postgres URL later, e.g.
# postgresql+psycopg2://user:pass@localhost:5432/eng_command_center
DATABASE_URL=sqlite:///./eng_command_center.db

# --- AI (optional, Phase 7) ---
AI_ENABLED=false
AI_PROVIDER=mock
OPENAI_API_KEY=

# --- Gmail (Phase 5) ---
GMAIL_USERNAME=
GMAIL_APP_PASSWORD=
# Deliberately short by default (spec section 5 requires this be
# configurable, not a full history pull). You asked for "today +
# yesterday" so pending items from yesterday still surface.
GMAIL_SYNC_WINDOW_DAYS=2
# Comma-separated custom Gmail label names to sync in addition to the
# inbox (e.g. "Jira,GitLab,Important"). Each one must have "Show in
# IMAP" enabled in Gmail's Labels settings, or IMAP simply won't see it -
# that setting is one thing to double check when we build this phase.
GMAIL_LABELS=

# --- Jira (Phase 2) ---
JIRA_BASE_URL=
JIRA_API_TOKEN=
# Two priority buckets are OR'd together, then Resolved/Closed/"Running
# on GM" are excluded from both (your team treats those as done/ignorable):
#   1. Anything in the currently active sprint (auto-resolves each
#      sprint via openSprints() - no need to hardcode sprint names like
#      "VTL-26R2.3(11/09-12/10)" and update this every cycle)
#   2. Automation/Defect issues reported by vaultAFTUser where Work Type
#      = Script Update, treated as sprint-priority even if not formally
#      in the sprint
# NOTE: "Work Type" is written here as a field name - if it's a custom
# field on your instance, Jira may need the field ID instead
# (e.g. cf[12345]). Verify once you're on VPN with real credentials.
JIRA_JQL=(assignee = currentUser() OR reporter = currentUser() OR (sprint in openSprints() ) OR (reporter = "vaultAFTUser" AND issuetype in (Automation, Defect) AND "Work Type" = "Script Update")) AND status not in (Resolved, Closed, "Running on GM")

# --- GitLab (Phase 2) ---
# Base URL of your self-hosted GitLab, e.g. https://gitlab.mycompany.com
GITLAB_BASE_URL=
# Personal Access Token with at least "read_api" scope
GITLAB_PERSONAL_ACCESS_TOKEN=
# Comma-separated project IDs (numeric) or URL-encoded paths, e.g. 42,113
GITLAB_PROJECT_IDS=
# Your GitLab username (used to filter "my MRs" / "assigned to me")
GITLAB_USERNAME=

# --- OpenSearch (Phase 3) ---
# Full base URL including scheme + port
OPENSEARCH_HOST=https://autoinfra-es.vaultdev.com:9200
# Leave both blank if the endpoint doesn't require auth on your network
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=
OPENSEARCH_INDEX_PATTERN=autoresult-*
OPENSEARCH_ENVIRONMENT=GM
OPENSEARCH_WINDOW_DAYS=90
# Jira issue types that count as an Xray test case (comma-separated)
OPENSEARCH_TEST_ISSUE_TYPES=Test
# OPEN QUESTION - fill in once you've shared a sample _source document:
# which field holds PASS/FAIL? e.g. "status", "result", "outcome"
OPENSEARCH_STATUS_FIELD=
# OPEN QUESTION - optional Kibana/Dashboards deep-link template, e.g.
# https://kibana.example.com/app/discover#/doc/<pattern-id>/{index}?id={doc_id}
OPENSEARCH_DASHBOARD_URL_TEMPLATE=
# Flip to false only if you hit self-signed-cert SSL errors
OPENSEARCH_VERIFY_SSL=true

# --- Calendar (Phase 4) ---
CALENDAR_PROVIDER=
